<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>

    <a href="/">Főoldal</a>
    <a href="/new">Új termék</a>
  
    <form action="/filter" method="get">
        <label for="category">Kategória:</label>
        <select id="category" name="category" value="<%= category %>">
            <option value="">Összes</option>
            <option value="elektronika" <%= category === 'elektronika' ? 'selected' : '' %>>Elektronika</option>
            <option value="ruházat" <%= category === 'ruházat' ? 'selected' : '' %>>Ruházat</option>
            <option value="könyv" <%= category === 'könyv' ? 'selected' : '' %>>Könyv</option>
            <option value="játék" <%= category === 'játék' ? 'selected' : '' %>>Játék</option>
        </select>
        <button type="submit">Szűrés</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>Termék neve</th>
                <th>Kategória</th>
                <th>Ár</th>
                <th>Raktárkészlet</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
                <tr class="<%= product.stock < 5 ? 'fogyoban' : '' %>">
                    <td><%= product.name %></td>
                    <td><%= product.category %></td>
                    <td><%= product.price %></td>
                    <td><%= product.stock %></td>
                </tr>
            <% }) %>
        </tbody>
</body>
</html>